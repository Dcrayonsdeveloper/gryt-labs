# PostgreSQL + Redis Production Configuration
# Copy this to .env when migrating from MySQL to PostgreSQL

# Database — PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_DATABASE=jikra
DB_USERNAME=jikra_admin
DB_PASSWORD=your_secure_password

# Central Database — PostgreSQL
CENTRAL_DB_DATABASE=jikra_central

# Cache — Redis
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=your-elasticache-endpoint.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# Session — Redis (faster than DB)
SESSION_DRIVER=redis
SESSION_CONNECTION=default

# Queue — Redis
QUEUE_CONNECTION=redis

# Tenancy — PostgreSQL database prefix
# Each tenant gets: {prefix}{tenant_id}
# e.g., tenant_natually, tenant_mystore
TENANT_SUBDOMAIN_BASE=dcrayons.app
